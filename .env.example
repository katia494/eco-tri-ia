# ECO-TRI — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs

# Backend
APP_NAME=ECO-TRI
APP_VERSION=1.0.0
DEBUG=False

# Base de données SQLite locale
DATABASE_URL=sqlite:///./eco_tri.db

# Modèle IA
MODEL_PATH=backend/models/best.pt
MODEL_VERSION=yolov8n-cls-v1
CONFIDENCE_THRESHOLD=0.50
MAX_UPLOAD_BYTES=10485760

# API
API_HOST=0.0.0.0
API_PORT=8000
